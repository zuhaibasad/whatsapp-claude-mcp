{
  "name": "wa-bridge",
  "version": "0.1.0",
  "description": "Read-only local WhatsApp bridge for Claude (MCP + CLI + skills). Personal use.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "bin": {
    "wa-bridge": "dist/cli/index.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@inquirer/core": "12.0.5",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/server": "2.3.1",
    "@napi-rs/keyring": "2.1.2",
    "baileys": "7.0.0-rc14",
    "better-sqlite3-multiple-ciphers": "13.0.3",
    "commander": "15.0.0",
    "pino": "10.4.0",
    "qrcode": "1.5.4",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@inquirer/testing": "3.3.15",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
